.upload-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.upload-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.04);
}
.upload-img {
  width: 100%;
  height: 100%;
}
.upload-del {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
}
.upload-add {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed rgba(0, 0, 0, 0.2);
}
.upload-add-icon {
  font-size: 56rpx;
  color: rgba(0, 0, 0, 0.35);
}
