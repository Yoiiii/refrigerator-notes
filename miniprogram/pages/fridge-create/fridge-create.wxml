<t-toast id="t-toast" />
<t-dialog id="t-dialog" />

<view class="theme-root" data-theme="{{theme}}">

<view class="nav-bar">
  <view class="nav-left" bind:tap="onBack">
    <t-icon name="chevron-left" size="36rpx" color="rgba(0,0,0,0.88)" />
  </view>
  <text class="nav-title">{{isEdit ? '编辑冰箱' : '创建冰箱'}}</text>
</view>

<scroll-view class="page-container" scroll-y enhanced show-scrollbar="{{false}}">
  <!-- 实时预览（最上面） -->
  <view class="card">
    <view class="preview-header">📐 实时预览</view>
    <view class="preview-body">
      <view class="preview-fridge-shell">
      <view class="preview-fridge-inner">
        <view class="preview-zones-single">
          <block wx:for="{{previewZones}}" wx:key="key" wx:for-item="entry">
            <view class="preview-zone cold" wx:if="{{entry.type === 'zone'}}">
              <text class="pz-title">{{entry.zone.tempType === 'cold' ? '❄' : '❄️'}} {{entry.zone.name}}</text>
              <view class="pz-layers">
                <view class="pz-layer" wx:for="{{entry.zone.layers}}" wx:for-item="layer" wx:key="layerId">{{layer.name}}</view>
              </view>
            </view>
            <view class="preview-zone constant" wx:else>
              <text class="pz-title">🌡 {{entry.zone.name}}</text>
              <view class="pz-layers">
                <view class="pz-layer" wx:for="{{entry.zone.layers}}" wx:for-item="layer" wx:key="layerId">{{layer.name}}</view>
              </view>
            </view>
          </block>
        </view>
      </view>
      </view>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="card">
    <view class="form-section-title">基本信息</view>
    <t-input label="名称" placeholder="如：客厅冰箱" value="{{fridgeName}}" bind:change="onNameChange" required borderless />
    <view class="form-cell">
      <text class="cell-label">门型</text>
      <t-radio-group value="{{doorType}}" bind:change="onDoorTypeChange">
        <t-radio label="单开门" value="single" />
        <t-radio label="双开门" value="double" />
      </t-radio-group>
    </view>
    <!-- 图标/图片 -->
    <t-tabs value="{{activeTab}}" bind:change="onTabChange">
      <t-tab-panel label="选择图标" value="icon" />
      <t-tab-panel label="上传图片" value="image" />
    </t-tabs>

    <view class="tab-content" wx:if="{{activeTab === 'icon'}}">
      <view class="preset-grid">
        <view
          class="preset-item {{selectedImageIndex === index ? 'selected' : ''}}"
          wx:for="{{presetImages}}"
          wx:key="*this"
          data-index="{{index}}"
          bind:tap="onSelectPresetImage"
        >
          <image src="{{item}}" mode="aspectFill" class="preset-img" />
          <view wx:if="{{selectedImageIndex === index}}" class="preset-selected-overlay">
            <t-icon name="check" size="28rpx" color="#fff" />
          </view>
        </view>
      </view>
    </view>

    <view class="tab-content" wx:if="{{activeTab === 'image'}}">
      <t-upload files="{{images}}" max="{{1}}" media-type="{{['image']}}" bind:add="onUploadAdd" bind:remove="onUploadRemove" />
    </view>
  </view>

  <!-- 恒温层开关 -->
  <view class="card">
    <view class="form-cell">
      <text class="cell-label">恒温层</text>
      <t-switch value="{{hasConstantZone}}" bind:change="onConstantZoneSwitch" />
    </view>
    <block wx:if="{{hasConstantZone}}">
      <t-input label="名称" placeholder="恒温区" value="{{constantZone.name}}" bind:change="onConstantZoneName" borderless />
      <view class="form-cell">
        <text class="cell-label">层数</text>
        <t-stepper value="{{constantZone.layers.length}}" min="1" max="2" bind:change="onConstantZoneLayers" />
      </view>
    </block>
  </view>

  <!-- 分区配置 -->
  <view class="card zone-card" wx:for="{{zones}}" wx:for-item="zone" wx:for-index="zi" wx:key="zoneId">
    <view class="zone-card-header">
      <view class="form-section-title">{{zone.name}}</view>
      <view class="zone-delete-btn" data-zi="{{zi}}" bind:tap="onDeleteZone">
        <t-icon name="close" size="28rpx" color="rgba(0,0,0,0.35)" />
      </view>
    </view>
    <t-input label="名称" value="{{zone.name}}" data-zi="{{zi}}" bind:change="onZoneNameChange" borderless />
    <view class="form-cell">
      <text class="cell-label">温度类型</text>
      <t-radio-group value="{{zone.tempType}}" data-zi="{{zi}}" bind:change="onZoneTempTypeChange">
        <t-radio label="冷藏" value="cold" />
        <t-radio label="冷冻" value="freeze" />
      </t-radio-group>
    </view>
    <view class="form-cell">
      <text class="cell-label">层数</text>
      <t-stepper value="{{zone.layers.length}}" min="1" max="6" data-zi="{{zi}}" bind:change="onZoneLayersChange" />
    </view>
  </view>

  <view class="add-zone" bind:tap="onAddZone">
    <t-icon name="add" size="28rpx" color="rgba(0,0,0,0.55)" />
    <text>添加分区</text>
  </view>
</scroll-view>

<view class="bottom-bar">
  <t-button theme="primary" size="large" class="save-btn" loading="{{saving}}" bind:tap="onSave">
    <t-icon name="check" slot="icon" />
    {{isEdit ? '保存修改' : '保存冰箱'}}
  </t-button>
</view>

</view>