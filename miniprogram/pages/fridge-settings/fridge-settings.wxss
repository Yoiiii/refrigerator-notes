.card { background: var(--card-bg,#FFFFFF); border-radius: var(--td-radius-medium); box-shadow: var(--card-shadow); margin: 16rpx 32rpx; overflow: hidden; }

.loading-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  gap: 24rpx;
}
.loading-text {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.35);
}