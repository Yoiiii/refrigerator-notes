<t-toast id="t-toast" />
<t-dialog
  visible="{{deleteVisible}}"
  title="删除物品"
  content="确定要删除该物品吗？"
  confirm-btn="删除"
  cancel-btn="取消"
  close-btn="{{true}}"
  bind:confirm="onDeleteConfirm"
  bind:cancel="onDeleteCancel"
  bind:close="onDeleteCancel"
/>

<view class="theme-root" data-theme="{{theme}}">

<view class="nav-bar">
    <view class="nav-left" bind:tap="onBack">
      <t-icon name="chevron-left" size="36rpx" color="rgba(0,0,0,0.88)" />
    </view>
    <text class="nav-title">{{fridgeName}}</text>
  </view>

<!-- 加载中：冰箱结构骨架屏 -->
<scroll-view wx:if="{{loading}}" class="page-container" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="fridge-shell">
    <view class="fridge-inner">
      <view class="fridge-top">
        <view class="sk-block" style="width:240rpx;height:30rpx;border-radius:8rpx"></view>
        <view class="sk-block" style="width:40rpx;height:40rpx;border-radius:10rpx"></view>
      </view>
      <view class="zones-grid">
        <view class="zone-col">
          <view class="zone-header"><view class="sk-block" style="width:120rpx;height:24rpx;margin:0 auto"></view></view>
          <view class="zone-layers">
            <view class="layer-row">
              <view class="sk-block" style="width:50%;height:26rpx"></view>
              <view class="sk-block" style="width:30%;height:20rpx;margin-top:10rpx"></view>
              <view class="items-expanded">
                <view class="item-cell"><view class="sk-block" style="width:64rpx;height:64rpx;border-radius:12rpx"></view><view class="sk-block" style="width:60%;height:24rpx"></view></view>
                <view class="item-cell"><view class="sk-block" style="width:64rpx;height:64rpx;border-radius:12rpx"></view><view class="sk-block" style="width:60%;height:24rpx"></view></view>
                <view class="add-item-row" style="color:transparent">添加物品</view>
              </view>
            </view>
            <view class="layer-row">
              <view class="sk-block" style="width:50%;height:26rpx"></view>
              <view class="sk-block" style="width:30%;height:20rpx;margin-top:10rpx"></view>
              <view class="items-expanded">
                <view class="item-cell"><view class="sk-block" style="width:64rpx;height:64rpx;border-radius:12rpx"></view><view class="sk-block" style="width:60%;height:24rpx"></view></view>
                <view class="add-item-row" style="color:transparent">添加物品</view>
              </view>
            </view>
          </view>
        </view>
        <view class="zone-col">
          <view class="zone-header"><view class="sk-block" style="width:120rpx;height:24rpx;margin:0 auto"></view></view>
          <view class="zone-layers">
            <view class="layer-row">
              <view class="sk-block" style="width:50%;height:26rpx"></view>
              <view class="sk-block" style="width:30%;height:20rpx;margin-top:10rpx"></view>
              <view class="items-expanded">
                <view class="item-cell"><view class="sk-block" style="width:64rpx;height:64rpx;border-radius:12rpx"></view><view class="sk-block" style="width:60%;height:24rpx"></view></view>
                <view class="add-item-row" style="color:transparent">添加物品</view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="stats-bar card">
    <view class="stats-item"><view class="sk-block" style="width:70rpx;height:36rpx;margin:0 auto 10rpx"></view><view class="sk-block" style="width:50rpx;height:20rpx;margin:0 auto"></view></view>
    <view class="stats-item"><view class="sk-block" style="width:70rpx;height:36rpx;margin:0 auto 10rpx"></view><view class="sk-block" style="width:50rpx;height:20rpx;margin:0 auto"></view></view>
    <view class="stats-item"><view class="sk-block" style="width:70rpx;height:36rpx;margin:0 auto 10rpx"></view><view class="sk-block" style="width:50rpx;height:20rpx;margin:0 auto"></view></view>
    <view class="stats-item"><view class="sk-block" style="width:70rpx;height:36rpx;margin:0 auto 10rpx"></view><view class="sk-block" style="width:50rpx;height:20rpx;margin:0 auto"></view></view>
  </view>
  </scroll-view>

<!-- 加载失败：空态 + 重试（P1-01） -->
<view wx:elif="{{loadError}}" style="padding:160rpx 40rpx;text-align:center;">
  <view style="font-size:80rpx;margin-bottom:24rpx;">😕</view>
  <view style="font-size:30rpx;color:rgba(0,0,0,0.6);margin-bottom:40rpx;">冰箱数据加载失败</view>
  <t-button theme="primary" size="medium" bind:tap="onRetry">重新加载</t-button>
</view>

<scroll-view wx:else class="page-container {{refreshing ? 'is-refreshing' : ''}}" scroll-y enhanced show-scrollbar="{{false}}">
  <!-- 拟物冰箱外壳 -->
  <view class="fridge-shell">
    <view class="fridge-inner">
      <view class="fridge-top">
          <view class="f-label">
            <image wx:if="{{fridgeImage}}" src="{{fridgeImage}}" class="fridge-top-img" />
            <text wx:else>🧊</text>
            <text>{{fridgeName}}</text>
            <t-tag size="small" theme="warning">{{doorTypeText}}</t-tag>
          </view>
          <view class="fridge-settings" bind:tap="onSettings">
            <t-icon name="setting" size="32rpx" color="rgba(0,0,0,0.55)" />
          </view>
        </view>

      <!-- 双开门 -->
      <view class="zones-grid" wx:if="{{doorType === 'double'}}">
        <view class="zone-col" wx:for="{{zones}}" wx:key="zoneId">
          <view class="zone-header {{item.tempType === 'cold' ? 'cold' : 'freeze'}}">
            {{item.tempType === 'cold' ? '❄' : '❄️'}} {{item.name}}
          </view>
          <view class="zone-layers">
            <view
              class="layer-row"
              wx:for="{{item.layers}}"
              wx:for-item="layer"
              wx:key="layerId"
              data-zone-id="{{item.zoneId}}"
              data-layer-id="{{layer.layerId}}"
              bind:tap="onLayerTap"
            >
              <view class="layer-top">
                <view class="layer-name">{{layer.emoji || '📦'}} {{layer.name}}</view>
                <t-tag size="small" theme="{{layer.statusTag}}">{{layer.statusText}}</t-tag>
              </view>
              <view class="layer-count">{{layer.itemCount}} 件物品</view>

              <view class="items-expanded" wx:if="{{layer.expanded}}">
                <my-swipe-cell wx:for="{{layer.items}}" wx:for-item="item" wx:key="_id">
                  <view class="item-cell" data-item-id="{{item._id}}" catch:tap="onItemDetail">
                    <view class="item-thumb">
                      <t-image wx:if="{{item.images && item.images.length > 0}}" src="{{item.images[0]}}" width="64rpx" height="64rpx" shape="round" />
                      <text wx:else>{{item.iconEmoji || '📦'}}</text>
                    </view>
                    <view class="item-info">
                      <view class="item-name">{{item.name}}</view>
                      <view class="item-expire {{item.status}}">{{item.expireDate}}{{item.expireText ? ' · ' + item.expireText : ''}}</view>
                    </view>
                    <t-badge count="{{item.quantity}}" size="small" />
                  </view>
                  <view slot="right" class="swipe-delete" wx:if="{{role !== 'readonly'}}" data-item-id="{{item._id}}" catch:tap="onDeleteItem">删除</view>
                </my-swipe-cell>
                <view class="add-item-row" wx:if="{{role !== 'readonly'}}" catch:tap="onAddItemFromLayer" data-zone-id="{{item.zoneId}}" data-layer-id="{{layer.layerId}}">
                  <t-icon name="add" size="24rpx" color="var(--td-brand-color)" />
                  <text>添加物品</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 单开门 -->
      <view class="zones-single" wx:else>
        <view class="zone-col {{entry.type === 'constant' ? 'is-constant' : ''}}" wx:for="{{displayZones}}" wx:key="key" wx:for-item="entry">
          <view class="zone-header {{entry.type === 'constant' ? 'constant' : (entry.zone.tempType === 'cold' ? 'cold' : 'freeze')}}">
            {{entry.type === 'constant' ? '🌡' : (entry.zone.tempType === 'cold' ? '❄' : '❄️')}} {{entry.zone.name}}
          </view>
          <view class="zone-layers">
            <view
              class="layer-row"
              wx:for="{{entry.zone.layers}}"
              wx:for-item="layer"
              wx:key="layerId"
              data-zone-id="{{entry.zone.zoneId}}"
              data-layer-id="{{layer.layerId}}"
              bind:tap="onLayerTap"
            >
              <view class="layer-top">
                <view class="layer-name">{{layer.emoji || '📦'}} {{layer.name}}</view>
                <t-tag size="small" theme="{{layer.statusTag}}">{{layer.statusText}}</t-tag>
              </view>
              <view class="layer-count">{{layer.itemCount}} 件物品</view>

              <view class="items-expanded" wx:if="{{layer.expanded}}">
                <my-swipe-cell wx:for="{{layer.items}}" wx:key="_id">
                  <view class="item-cell" data-item-id="{{item._id}}" catch:tap="onItemDetail">
                    <view class="item-thumb">
                      <t-image wx:if="{{item.images && item.images.length > 0}}" src="{{item.images[0]}}" width="64rpx" height="64rpx" shape="round" />
                      <text wx:else>{{item.iconEmoji || '📦'}}</text>
                    </view>
                    <view class="item-info">
                      <view class="item-name">{{item.name}}</view>
                      <view class="item-expire {{item.status}}">{{item.expireDate}}{{item.expireText ? ' · ' + item.expireText : ''}}</view>
                    </view>
                    <t-badge count="{{item.quantity}}" size="small" />
                  </view>
                  <view slot="right" class="swipe-delete" wx:if="{{role !== 'readonly'}}" data-item-id="{{item._id}}" catch:tap="onDeleteItem">删除</view>
                </my-swipe-cell>
                <view class="add-item-row" wx:if="{{role !== 'readonly'}}" catch:tap="onAddItemFromLayer" data-zone-id="{{entry.zone.zoneId}}" data-layer-id="{{layer.layerId}}">
                  <t-icon name="add" size="24rpx" color="var(--td-brand-color)" />
                  <text>添加物品</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 恒温层（双开门：统一在底部） -->
      <view class="constant-zone" wx:if="{{doorType === 'double' && hasConstantZone && constantZone}}">
        <view class="zone-header constant">🌡 {{constantZone.name}}</view>
        <view class="zone-layers">
          <view
            class="layer-row"
            wx:for="{{constantZone.layers}}"
            wx:for-item="layer"
            wx:key="layerId"
            data-zone-id="{{constantZone.zoneId}}"
            data-layer-id="{{layer.layerId}}"
            bind:tap="onLayerTap"
          >
            <view class="layer-top">
              <view class="layer-name">{{layer.emoji || '📦'}} {{layer.name}}</view>
              <t-tag size="small" theme="{{layer.statusTag}}">{{layer.statusText}}</t-tag>
            </view>
            <view class="layer-count">{{layer.itemCount}} 件物品</view>

            <view class="items-expanded" wx:if="{{layer.expanded}}">
              <my-swipe-cell wx:for="{{layer.items}}" wx:key="_id">
                <view class="item-cell" data-item-id="{{item._id}}" catch:tap="onItemDetail">
                  <view class="item-thumb">
                    <t-image wx:if="{{item.images && item.images.length > 0}}" src="{{item.images[0]}}" width="64rpx" height="64rpx" shape="round" />
                    <text wx:else>{{item.iconEmoji || '📦'}}</text>
                  </view>
                  <view class="item-info">
                    <view class="item-name">{{item.name}}</view>
                    <view class="item-expire {{item.status}}">{{item.expireDate}}</view>
                  </view>
                  <t-badge count="{{item.quantity}}" size="small" />
                </view>
                <view slot="right" class="swipe-delete" wx:if="{{role !== 'readonly'}}" data-item-id="{{item._id}}" catch:tap="onDeleteItem">删除</view>
              </my-swipe-cell>
              <view class="add-item-row" catch:tap="onAddItemFromLayer" data-zone-id="{{constantZone.zoneId}}" data-layer-id="{{layer.layerId}}">
                <t-icon name="add" size="24rpx" color="var(--td-brand-color)" />
                <text>添加物品</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

    <!-- 添加物品按钮 -->
    <!-- <view class="add-item-global">
      <t-button theme="primary" size="large" block bind:tap="onAddItem">
        <t-icon name="add" slot="icon" />
        添加物品
      </t-button>
    </view> -->

    <!-- 统计栏 -->
  <view class="stats-bar card">
    <view class="stats-item">
      <text class="s-num">{{stats.total}}</text>
      <text class="s-label">物品总数</text>
    </view>
    <view class="stats-item">
      <text class="s-num warning">{{stats.expiring}}</text>
      <text class="s-label">临期</text>
    </view>
    <view class="stats-item">
      <text class="s-num danger">{{stats.expired}}</text>
      <text class="s-label">已过期</text>
    </view>
    <view class="stats-item">
      <text class="s-num safe">{{stats.safe}}</text>
      <text class="s-label">安全</text>
    </view>
  </view>
</scroll-view>

</view>
