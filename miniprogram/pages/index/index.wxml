<t-toast id="t-toast" />
<t-dialog id="t-dialog" />

<view class="theme-root" data-theme="{{theme}}">

<!-- 自定义导航栏 -->
<view class="nav-bar">
  <view class="nav-left">
    <t-icon name="notification" size="36rpx" color="rgba(0,0,0,0.88)" bind:tap="onNotification" />
  </view>
  <text class="nav-title">冰箱笔记</text>
</view>

<!-- 加载中 -->
<view class="page-container" wx:if="{{loading}}">
  <view class="loading-wrapper">
    <t-loading theme="circular" size="64rpx" />
    <text class="loading-text">加载中...</text>
  </view>
</view>

<!-- 空状态：无冰箱（不滚动） -->
<view class="page-container" wx:elif="{{!hasFridge}}">
  <view class="empty-wrapper">
    <view class="empty-illustration">
      <text class="empty-emoji">🧊</text>
    </view>
    <t-empty description="还没有冰箱" />
    <view class="empty-desc">创建一个冰箱，开始记录食材的存放位置与保质期</view>
    <t-button theme="primary" size="large" class="empty-btn" bind:tap="onCreateFridge">
      <t-icon name="add" slot="icon" />
      创建冰箱
    </t-button>
  </view>
</view>

<!-- 有冰箱状态（可滚动+下拉刷新） -->
<t-pull-down-refresh wx:else value="{{refreshing}}" bind:refresh="onRefresh" loading-texts="{{['下拉刷新', '松手刷新', '正在刷新']}}">
  <scroll-view class="page-container" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 冰箱卡片 -->
    <view class="card fridge-card" bind:tap="onGoFridge" data-fridge-id="{{currentFridge.fridgeId}}">
      <view class="fridge-card-head">
        <image wx:if="{{currentFridge.image}}" src="{{currentFridge.image}}" class="fridge-avatar-img" />
        <view wx:else class="fridge-avatar">🧊</view>
        <view class="fridge-info">
          <view class="fridge-name">{{currentFridge.name}}</view>
          <view class="fridge-desc">{{currentFridge.doorType === 'double' ? '双开门' : '单开门'}} · {{currentFridge.totalItems}} 件物品</view>
        </view>
        <t-icon name="chevron-right" size="32rpx" color="rgba(0,0,0,0.35)" />
      </view>
      <view class="fridge-stats">
        <view class="fridge-stat">
          <text class="num">{{currentFridge.totalItems}}</text>
          <text class="label">物品总数</text>
        </view>
        <view class="fridge-stat">
          <text class="num warning">{{currentFridge.expiringCount}}</text>
          <text class="label">临期</text>
        </view>
        <view class="fridge-stat">
          <text class="num danger">{{currentFridge.expiredCount}}</text>
          <text class="label">已过期</text>
        </view>
      </view>
    </view>

    <!-- 切换冰箱 -->
    <view class="switch-bar" bind:tap="onSwitchFridge">
      <t-icon name="swap" size="28rpx" color="var(--td-brand-color)" />
      <text>切换冰箱</text>
    </view>

    <!-- 临期提醒横幅 -->
    <view class="expire-banner" wx:if="{{currentFridge.expiringCount > 0 || currentFridge.expiredCount > 0}}" bind:tap="onGoFridge">
      <view class="banner-icon">⚠️</view>
      <view class="banner-text">
        <text class="banner-highlight">{{currentFridge.expiringCount + currentFridge.expiredCount}} 件物品</text>需要处理
      </view>
      <text class="banner-action">查看 ›</text>
    </view>

    <!-- 快捷操作 -->
    <view class="quick-actions">
      <t-button theme="primary" size="medium" class="quick-btn" bind:tap="onAddItem">
        <t-icon name="add" slot="icon" />
        添加物品
      </t-button>
      <t-button theme="default" size="medium" class="quick-btn outline" bind:tap="onManageFridge">
        <t-icon name="setting" slot="icon" />
        管理冰箱
      </t-button>
    </view>

    <!-- 临期物品列表 -->
    <view class="section-header" wx:if="{{expiringItems.length > 0}}">
      <text class="s-title">临期提醒</text>
      <text class="s-more" bind:tap="onGoFridge">查看全部 ›</text>
    </view>

    <view class="card" wx:if="{{expiringItems.length > 0}}">
      <t-swipe-cell wx:for="{{expiringItems}}" wx:key="itemId" right="{{swipeRight}}">
        <view class="expire-item" data-item-id="{{item._id}}" bind:tap="onItemDetail">
          <view class="item-emoji">{{item.iconEmoji || '📦'}}</view>
          <view class="item-info">
            <view class="item-name">{{item.name}}</view>
            <view class="item-location">{{item.locationText}}</view>
          </view>
          <t-tag theme="{{item.status === 'danger' ? 'danger' : 'warning'}}" size="small">
            {{item.statusText}}
          </t-tag>
        </view>
        <view slot="right" class="swipe-delete" data-item-id="{{item._id}}" catch:tap="onDeleteExpiringItem">
          删除
        </view>
      </t-swipe-cell>
    </view>

    <t-empty wx:elif="{{hasFridge && expiringItems.length === 0}}" description="暂无临期物品 🎉" />
  </scroll-view>
</t-pull-down-refresh>

<!-- TabBar -->
<t-tab-bar theme="tag" value="home" bind:change="onTabChange">
  <t-tab-bar-item value="home" icon="home">首页</t-tab-bar-item>
  <t-tab-bar-item value="mine" icon="user">我的</t-tab-bar-item>
</t-tab-bar>

<!-- 浮动添加按钮 -->
<view class="fab" bind:tap="onCreateFridge">
  <t-icon name="add" size="40rpx" color="#FFFFFF" />
</view>

</view>