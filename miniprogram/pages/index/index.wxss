/* 首页样式 */

/* 加载中 */
.loading-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  gap: 24rpx;
}
.loading-text {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.35);
}

/* 空状态 */
.empty-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 80rpx 80rpx;
  text-align: center;
}
.empty-illustration {
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fff0e0 0%, #ffe8d0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(255, 159, 69, 0.12);
}
.empty-emoji {
  font-size: 120rpx;
}
.empty-desc {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.55);
  margin: 16rpx 0 32rpx;
  line-height: 1.6;
}
.empty-btn {
  width: 400rpx;
}

.fridge-card {
  background: var(--card-bg, #ffffff);
  border-radius: var(--td-radius-medium);
  box-shadow: var(--card-shadow);
  overflow: hidden;
  margin: 16rpx 32rpx;
}
.fridge-card-head {
  display: flex;
  align-items: center;
  padding: 32rpx;
  gap: 24rpx;
}
.fridge-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fff0e0 0%, #ffe0c0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  flex-shrink: 0;
}
.fridge-avatar-img {
  width: 104rpx;
  height: 104rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  object-fit: cover;
}
.fridge-info {
  flex: 1;
  min-width: 0;
}
.fridge-name {
  font-size: 34rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.88);
}
.fridge-desc {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.55);
  margin-top: 6rpx;
}
.fridge-stats {
  display: flex;
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}
.fridge-stat {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  border-right: 1rpx solid rgba(0, 0, 0, 0.04);
}
.fridge-stat:last-child {
  border-right: none;
}
.fridge-stat .num {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
  color: rgba(0, 0, 0, 0.88);
}
.fridge-stat .num.warning {
  color: var(--td-warning-color);
}
.fridge-stat .num.danger {
  color: var(--td-error-color);
}
.fridge-stat .label {
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.55);
  margin-top: 4rpx;
  display: block;
}

.switch-bar {
  margin: 0 32rpx 24rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--td-brand-color);
  font-weight: 500;
  background: var(--card-bg, #ffffff);
  border-radius: var(--td-radius-medium);
  box-shadow: var(--card-shadow);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.expire-banner {
  margin: 0 32rpx 24rpx;
  padding: 24rpx 32rpx;
  border-radius: var(--td-radius-medium);
  background: linear-gradient(135deg, #fff7ee 0%, #fff0e0 100%);
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 1rpx solid rgba(255, 159, 69, 0.12);
}
.banner-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 159, 69, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}
.banner-text {
  flex: 1;
  font-size: 28rpx;
  color: #8b5e30;
  line-height: 1.4;
}
.banner-highlight {
  color: #c47720;
  font-weight: 600;
}
.banner-action {
  font-size: 26rpx;
  color: var(--td-brand-color);
  font-weight: 500;
  flex-shrink: 0;
}

.quick-actions {
  margin: 0 32rpx 24rpx;
  display: flex;
  gap: 20rpx;
}
.quick-btn {
  flex: 1;
}

.expire-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
  background: var(--card-bg, #ffffff);
}
.expire-item:last-child {
  border-bottom: none;
}
.item-emoji {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: var(--td-bg-color-page);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.item-info {
  flex: 1;
}
.item-name {
  font-size: 30rpx;
  font-weight: 500;
  color: rgba(0, 0, 0, 0.88);
}
.item-location {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.55);
  margin-top: 4rpx;
}

.swipe-delete {
  background: var(--td-error-color);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
  height: 100%;
}
