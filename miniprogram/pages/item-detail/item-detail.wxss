/* 物品详情 */
.card { background: var(--card-bg,#FFFFFF); border-radius: var(--td-radius-medium); box-shadow: var(--card-shadow); margin: 16rpx 32rpx; overflow: hidden; }
.detail-header { display: flex; align-items: center; padding: 48rpx 40rpx; gap: 32rpx; }
.detail-thumb { width: 200rpx; height: 200rpx; border-radius: 24rpx; background: var(--td-bg-color-page); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.detail-emoji { font-size: 100rpx; }
.detail-meta { flex: 1; }
.detail-name { font-size: 40rpx; font-weight: 700; color: rgba(0,0,0,0.88); margin-bottom: 16rpx; }
.edit-tag { margin-left: 12rpx; }

.form-cell { display: flex; align-items: center; padding: 24rpx 32rpx; min-height: 88rpx; border-bottom: 1rpx solid rgba(0,0,0,0.04); }
.cell-label { width: 136rpx; font-size: 28rpx; color: rgba(0,0,0,0.88); flex-shrink: 0; }
.picker-val { display: flex; align-items: center; gap: 8rpx; }

.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 24rpx 32rpx 48rpx; background: var(--card-bg,#FFFFFF); border-top: 1rpx solid rgba(0,0,0,0.04); z-index: 100; display: flex; gap: 16rpx; }
.bar-btn { flex: 1; }