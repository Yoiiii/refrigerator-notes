/* 物品编辑页 */
.card {
  background: var(--card-bg, #ffffff);
  border-radius: var(--td-radius-medium);
  box-shadow: var(--card-shadow);
  margin: 16rpx 32rpx;
  overflow: hidden;
}
.form-cell {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  min-height: 88rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}
.form-cell:last-child {
  border-bottom: none;
}
.cell-label {
  width: 136rpx;
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.88);
  flex-shrink: 0;
}
.picker-val {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.88);
  min-width: 200rpx;
  justify-content: flex-end;
}

.tab-content {
  padding: 24rpx 32rpx;
}

/* 图标面板 */
.icon-panel {
  padding: 16rpx 24rpx;
}
.icon-categories {
  margin-bottom: 24rpx;
}
.icon-cat-name {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.55);
  margin-bottom: 12rpx;
  padding-left: 8rpx;
}
.icon-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.icon-item {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: var(--td-bg-color-page);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}
.icon-item.selected {
  border-color: var(--td-brand-color);
  background: rgba(255, 159, 69, 0.08);
}
.icon-emoji {
  font-size: 40rpx;
}
.icon-label {
  font-size: 20rpx;
  color: rgba(0, 0, 0, 0.55);
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx 48rpx;
  background: var(--card-bg, #ffffff);
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
  z-index: 100;
}
.save-btn {
  width: 100%;
}
