<t-toast id="t-toast" />
<t-dialog
  visible="{{removeVisible}}"
  title="移除成员"
  content="{{removeMemberText}}"
  confirm-btn="移除"
  cancel-btn="取消"
  close-btn="{{true}}"
  bind:confirm="onRemoveConfirm"
  bind:cancel="onRemoveCancel"
  bind:close="onRemoveCancel"
/>
<view class="theme-root" data-theme="{{theme}}">

<view class="nav-bar">
  <view class="nav-left" bind:tap="onBack">
    <t-icon name="chevron-left" size="36rpx" color="rgba(0,0,0,0.88)" />
  </view>
  <text class="nav-title">成员管理</text>
</view>

<scroll-view class="page-container" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="card" wx:if="{{members.length > 0}}">
    <view class="member-card" wx:for="{{members}}" wx:key="userId">
      <t-avatar size="medium" image="{{item.avatarUrl || ''}}" icon="{{item.avatarUrl ? '' : 'user'}}" />
      <view class="member-info">
        <view class="member-name">
          <text class="member-name-text">{{item.nickname || '微信用户'}}</text>
          <t-tag wx:if="{{item.role === 'owner'}}" theme="warning" size="small">所有者</t-tag>
        </view>
        <view class="member-role">{{item.roleText}}</view>
      </view>
      <view class="member-actions" wx:if="{{isOwner && item.role !== 'owner'}}">
        <t-button size="small" theme="default" data-member="{{item}}" bind:tap="onChangeRole">改角色</t-button>
        <t-button size="small" theme="danger" data-member="{{item}}" bind:tap="onRemove">移除</t-button>
      </view>
    </view>
  </view>
  <view class="empty-state" wx:else>
    <block wx:if="{{loadFailed}}">
      <text class="empty-text">成员加载失败</text>
      <t-button size="small" theme="default" bind:tap="onRetry">点击重试</t-button>
    </block>
    <block wx:else>
      <text class="empty-text">暂无成员</text>
    </block>
  </view>

  <view class="card" wx:if="{{isOwner && members.length > 1}}">
    <t-cell title="转让所有权" note="选择新所有者" arrow hover bind:tap="onTransfer" />
  </view>
</scroll-view>

</view>
