.card { background: var(--card-bg,#FFFFFF); border-radius: var(--td-radius-medium); box-shadow: var(--card-shadow); margin: 16rpx 32rpx; overflow: hidden; }
.form-section-title { padding: 24rpx 32rpx 12rpx; font-size: 24rpx; font-weight: 600; color: rgba(0,0,0,0.55); }
.role-group { padding: 12rpx 32rpx 24rpx; }
.qr-card { padding: 48rpx 32rpx; display: flex; flex-direction: column; align-items: center; gap: 24rpx; }
.qr-tip { font-size: 24rpx; color: rgba(0,0,0,0.55); }
.generate-area { padding: 80rpx 32rpx; display: flex; justify-content: center; }